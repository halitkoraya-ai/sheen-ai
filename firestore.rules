rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Config: read-only for authenticated users
    match /config/{document} {
      allow read: if request.auth != null;
    }

    // Users: own data only, tier is read-only for clients
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['tier']);
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /usage/{monthId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Write only via Cloud Functions (admin SDK) — tamper-proof metering.
      }
    }

    // Sessions: own data only
    match /sessions/{sessionId} {
      allow read, update, delete: if request.auth != null
                                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      match /segments/{segmentId} {
        allow read, write: if request.auth != null
                    && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
      }

      match /chatMessages/{messageId} {
        allow read, create, delete: if request.auth != null
                    && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
      }
    }

    // Deletion records: written by Cloud Functions only (admin SDK).
    // No client access needed.
    match /deletions/{docId} {
      allow read, write: if false;
    }
  }
}
