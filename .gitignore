# ── Dependencies ─────────────────────────────────────────────────────
node_modules/
functions/node_modules/
server/node_modules/

# ── Build artifacts ─────────────────────────────────────────────────
# Web app — single-file dist gets regenerated on every deploy.
dist/
# Cloud Functions — TypeScript output, regenerated on every deploy.
functions/lib/
# Streaming server — TypeScript output, regenerated by the Docker build.
server/dist/

# ── Logs ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log
firebase-debug.*.log
.pnpm-debug.log*

# ── Environment / secrets — NEVER commit these ──────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem
*.key
secrets.json
service-account*.json
google-services.json
GoogleService-Info.plist
firebase-adminsdk-*.json
.runtimeconfig.json

# ── Editor / IDE ────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── OS ──────────────────────────────────────────────────────────────
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Capacitor / mobile (future) ─────────────────────────────────────
# Generated platform projects — restored locally with `npx cap add`
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
android/.gradle/
android/build/
android/app/build/
android/app/release/

# ── Local Claude session files (don't ship) ─────────────────────────
.claude/

# ── Misc ────────────────────────────────────────────────────────────
*.local
coverage/
.nyc_output/
.cache/
.parcel-cache/
.next/
.nuxt/
out/
